docs/**
gifs and screenshots/**
ScreenShot*.jpg
# Root-level images are never referenced by the README (it uses assets/),
# so a screenshot dropped in the repo root must not ship to users.
*.jpg
*.png
# Same rule for audio, and it bites harder: a scratch capture from the voice
# work is a recording of someone speaking. whisper-resident-live.wav shipped
# inside 0.15.14's VSIX because only images were excluded here.
*.wav
legacy/**
.claude/**
.cursor/**
.vscode/**
.forge/**
test/**
**/*.test.ts
**/*.spec.ts
coverage/**
tool-result-context-ab-results/**
# Benchmark run output. Not just bulk: vsce walks every path that is not
# excluded here, and on a network drive a few thousand run directories take
# longer than the packaging step itself - two `vsce package` runs hung for
# over an hour on this before it was ignored. Nothing under it belongs in a
# published extension.
results/**
.github/**
esbuild.config.mjs
tsconfig.json
.eslintrc.json
.prettierrc
vitest.config.*
*.md
!README.md
# Generated from CHANGES.md by scripts/sync-changelog.mjs. Without this line the
# `*.md` rule above strips it and both registries show "No changelog available".
!CHANGELOG.md
src/**
webview-ui/**
node_modules/**
scripts/**
.gitignore
.vscodeignore
**/*.map
**/*.vsix
.coordination/**
smoke3d/**
prodtest-md2html/**
prodtest-*/**
.mcp.json
assets/.coordination/**
assets/_preview/**
assets/publisher-logo.svg
