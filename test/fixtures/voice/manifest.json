    {
      "id": "silence-only",
      "language": "en",
      "text": "",
      "source": "generated-silence",
      "durationSeconds": 2,
      "expect": { "grammar": null, "rejectAs": "empty" }
    },
    {
      "id": "trailing-silence",
      "language": "en",
      "text": "restart the backend",
      "source": "synthetic",
      "voice": "en_US-amy-medium",
      "trailingSilenceSeconds": 6,
      "expect": {
        "grammar": null,
        "critical": ["restart", "backend"],
        "$comment": "The §27.1 hallucination trigger: assert the transcript ends where speech does.",
        "mustNotRepeatFinalLine": true
      }
    }
  ]
}
