exports[`message_chat new and steer actions > pins the full disabled definition and refuses stale new/steer calls 1`] = `"{"type":"function","function":{"name":"message_chat","description":"Message another Forge chat in this window. \`send\`: \`to\` is a chat id, \`#N\` from \`list\`, or words from the chat's title; omit \`to\` to reach the other chat when exactly one other chat is running (or open). No \`list\` needed first. A running chat reads it at its next tool round; an idle chat starts a turn. Replies arrive the same way. \`list\`: show the chats. \`action\` defaults to \`send\` when a \`message\` is given, so a message alone is enough. \`view\`: read what one named chat has done — its last prompt/answer pairs, at most 10; \`to\` is required, and reading changes nothing. \`view\` also reads a closed chat by id or title, and marks the result \`closed\`.","parameters":{"type":"object","properties":{"action":{"type":"string","enum":["list","send","view"]},"to":{"type":"string","minLength":1,"maxLength":200,"description":"Another chat only: use its chat id, its #N tab number from list, or words from its title. Never target this chat. A closed chat must be read with action: view."},"message":{"type":"string","minLength":1,"maxLength":12000,"description":"Write it as you would to a coworker: first person, call the other chat 'you', no formalities, no reports about yourself in the third person. At most 12,000 characters; send a longer message in parts."}},"required":[],"additionalProperties":false}}}"`;
