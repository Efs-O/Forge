docs/**
gifs and screenshots/**
ScreenShot*.jpg
# Root-level images are never referenced by the README (it uses assets/),
# so a screenshot dropped in the repo root must not ship to users.
*.jpg
*.png
# Same rule for audio, and it bites harder: a scratch capture from the voice
# work is a recording of someone speaking. whisper-resident-live.wav shipped
# inside 0.15.14's VSIX because only images were excluded here.
*.wav
# The README's demo GIF is 5 MB and only the listing page shows it; the README
# links it by absolute URL, so the Marketplace still renders it.
assets/readme/demo.gif
legacy/**
.claude/**
.cursor/**
.vscode/**
.forge/**
test/**
**/*.test.ts
**/*.spec.ts
coverage/**
tool-result-context-ab-results/**
# Benchmark run output. Not just bulk: vsce walks every path that is not
# excluded here, and on a network drive a few thousand run directories take
# longer than the packaging step itself - two `vsce package` runs hung for
# over an hour on this before it was ignored. Nothing under it belongs in a
# published extension.
results/**
# Workspace render inputs and outputs are user data, not extension resources.
media/**
# The runner that reads these manifests is scripts/forge-bench.mjs, which is
# excluded below, and nothing in src/ resolves this path -- so shipping them put
# dead files in front of users with no way to run them.
benchmarks/**
.github/**
# The git hooks are this repository's push gate (`git config core.hooksPath .githooks`): they
# must stay tracked, but an installed extension has no repository to read them from, and the
# VSIX contents gate in scripts/check-vsix-contents.mjs rejects any path it does not allow.
.githooks/**
esbuild.config.mjs
tsconfig.json
.eslintrc.json
.prettierrc
vitest.config.*
*.md
# vsce matches `*.md` against the root only, so a note in a subdirectory ships
# unnoticed: benchmarks/COST_ESTIMATES.md rode along in every VSIX until 0.15.27.
**/*.md
!README.md
# Read by the user's Claude Code / Codex via forge.setupWithAgent.
!AI_SETUP.md
!config/contact-instructions.example.md
# The shipped skills folder (`resources/skills/`). `**/*.md` below the root strips
# every `SKILL.md`, and `SKILL.md` IS the skill: without these lines the scripts
# ship with no way to learn what they do, or that they exist. The `.py` exception
# is here because a shipped skill's script is the feature too, and `*.json` and
# `*.txt` at the root would otherwise leave nothing to check. What actually lands
# in the VSIX is checked by `test/unit/ShippedSkills.test.ts`.
skills-lab/**
!resources/skills/**/SKILL.md
!resources/skills/**/*.md
!resources/skills/**/*.py
# The shipped coding-tips table (`resources/tips/`): `**/*.md` below the root strips
# it, and an agent that cannot see the table re-makes the mistakes it lists. The VSIX
# contents are checked by `test/unit/CodingTipsInjection.test.ts`.
!resources/tips/CODING_TIPS.md
# The starter FORGE.md: Forge bundles its text, but AI_SETUP.md Step 1 tells the
# setup agent to copy this file, so it has to exist in the installed extension.
!resources/instructions/FORGE.starter.md
# Runtime Python adapters and the LTX graph skeleton are loaded from the
# extension folder; exclude only their tests from the shipped package.
!resources/media/media_job.py
!resources/media/media_comfy.py
!resources/media/video_ltx25.py
!resources/media/video_h3.py
!resources/media/video_h3_blueprint.py
!resources/media/video_ltx25_api_skeleton.json
!resources/media/music_ace.py
!resources/media/music_sa3.py
!resources/media/music_analyze.py
resources/media/tests/**
resources/media/tests/*.py
resources/media/.gitignore
# Generated from CHANGES.md by scripts/sync-changelog.mjs. Without this line the
# `*.md` rule above strips it and both registries show "No changelog available".
!CHANGELOG.md
src/**
webview-ui/**
node_modules/**
scripts/**
.gitignore
.vscodeignore
**/*.map
# Scratch bundles in dist/ (underscore-prefixed). A 7 MB dist/_hashcheck.js, left
# from checking whether a fix was in the bundle, rode along in four local VSIXs.
# The build only ever emits extension.js and webview/.
dist/_*
# One-off browser layout preview used for local visual QA, never extension code.
dist/qa-layout/**
.test-tmp/**
**/*.vsix
# Vitest --reporter=json debug dump written to the workspace root. A 1 MB
# .ci-failures.json rode along inside a 0.16.58 VSIX until this line existed.
.ci-failures.json
# Any root JSON or text file other than the manifest and the licence is a local
# dump: flaky-*.json, test-run-*.json and flaky-log-*.txt rode along in a 0.17.0
# VSIX. Like `*.md`, these patterns match the root only.
*.json
!package.json
*.txt
!LICENSE.txt
*.log
.coordination/**
smoke3d/**
prodtest-md2html/**
prodtest-*/**
# A voxel-page build left in the repo root rode along in a local 0.17.22 VSIX.
pagoda.html
pagoda-build/**
.mcp.json
assets/.coordination/**
assets/_preview/**
assets/publisher-logo.svg

# Local generate_image output (the agent also saves to images/ when asked)
generated-images/**
images/**
artifacts/**

# Python tool caches. pytest run from the repo root writes .pytest_cache/ with a
# self-ignoring .gitignore, so git status never shows it, and a local 0.17.96
# build carried one holding the test names of a private skill outside this repo.
**/.pytest_cache/**
**/__pycache__/**
**/*.pyc
# A local working folder (session-scan output); never ships.
scratch/**
